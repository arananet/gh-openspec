#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/utils.sh"

VERSION="0.1.0"
SUBCOMMAND="${1:-help}"
shift || true

case "$SUBCOMMAND" in
  create)
    source "$SCRIPT_DIR/lib/cmd_create.sh"
    cmd_create "$@"
    ;;
  init)
    source "$SCRIPT_DIR/lib/cmd_init.sh"
    cmd_init "$@"
    ;;
  scaffold)
    source "$SCRIPT_DIR/lib/cmd_scaffold.sh"
    cmd_scaffold "$@"
    ;;
  check)
    source "$SCRIPT_DIR/lib/cmd_check.sh"
    cmd_check "$@"
    ;;
  version|--version|-v)
    echo "gh-openspec $VERSION"
    ;;
  help|--help|-h)
    print_help
    ;;
  *)
    error "Unknown subcommand: $SUBCOMMAND"
    echo ""
    print_help
    exit 1
    ;;
esac
